rules_version = '2';
// Solo pueden leer y escribir los usuarios de esta lista (Juan y su papá).
// Reemplazá los mails por los reales antes de publicar las reglas.
service cloud.firestore {
  match /databases/{database}/documents {
    function esDueno() {
      return request.auth != null
        && request.auth.token.email in ['juan@ejemplo.com', 'papa@ejemplo.com'];
    }
    match /{coleccion}/{id} {
      allow read, write: if esDueno()
        && coleccion in ['clientes', 'eventos', 'ipc', 'extrasCat', 'egresos', 'config'];
    }
    // Portal del cliente: cualquiera con el link (id secreto) puede leer ESE documento,
    // nadie puede listar la colección, y solo los dueños pueden escribir.
    match /portal/{id} {
      allow get: if true;
      allow list: if false;
      allow write: if esDueno();
    }
    // Plano que completa el cliente desde su link: cualquiera con el link puede leer y guardar ESE documento
    // (solo mesas: quiénes, cuántos y menús especiales). La app de los dueños lo revisa y lo pasa al evento.
    match /portalPlano/{id} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.resource.data.keys().hasOnly(['items', 'actualizado'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 100;
      allow delete: if esDueno();
    }
  }
}
